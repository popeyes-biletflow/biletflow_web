# Supabase project (Settings -> API). Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
# FS-20: service role key, server side only. Needed to write the email outbox
# and look up recipients' emails. Leave empty to send in-app notices only.
SUPABASE_SERVICE_KEY=

# HMAC secret for ticket QR codes. Generate a long random value, keep it secret.
QR_SECRET=replace_with_a_long_random_secret

PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# FS-20: transactional email (demo mailbox: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=BiletFlow <no-reply@biletflow.local>
EMAIL_ENABLED=true
EMAIL_LANG=ru
EMAIL_PREVIEW_DIR=outbox_previews
